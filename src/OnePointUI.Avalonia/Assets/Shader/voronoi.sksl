uniform vec2 iDrift;
uniform float iPhase;

const float CELLS = 10.0;
const float HASH_PERIOD = 64.0;
const float AMP_MIN = 0.18;
const float AMP_MAX = 0.32;
const float TAU = 6.2831853;

vec3 blendOverlay(vec3 base, vec3 blend) {
    return vec3(
        base.r < 0.5 ? (2.0 * base.r * blend.r) : (1.0 - 2.0 * (1.0 - base.r) * (1.0 - blend.r)),
        base.g < 0.5 ? (2.0 * base.g * blend.g) : (1.0 - 2.0 * (1.0 - base.g) * (1.0 - blend.g)),
        base.b < 0.5 ? (2.0 * base.b * blend.b) : (1.0 - 2.0 * (1.0 - base.b) * (1.0 - blend.b))
    );
}

vec2 hash22(vec2 p) {
    vec3 p3 = fract(vec3(p.x, p.y, p.x) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((vec2(p3.x, p3.x) + vec2(p3.y, p3.z)) * vec2(p3.z, p3.y));
}

vec2 seedOffset(vec2 id) {
    vec2 q = mod(id, HASH_PERIOD);
    vec2 h = hash22(q);
    vec2 h2 = hash22(q + 19.19);
    float kx = 1.0 + floor(h.x * 4.0);
    float ky = 1.0 + floor(h.y * 4.0);
    vec2 phase = h2 * TAU;
    float amplitude = AMP_MIN + (AMP_MAX - AMP_MIN) * fract(h.y * 7.31);
    return vec2(sin(iPhase * kx + phase.x), sin(iPhase * ky + phase.y)) * amplitude;
}

vec4 main(vec2 fragCoord)
{
    vec2 p = (fragCoord - 0.5 * iResolution.xy) / iResolution.x;
    vec2 uv = p * CELLS + iDrift;
    vec2 gv = fract(uv) - 0.5;
    vec2 id = floor(uv);

    float mindist = 1e9;
    vec2 cell = vec2(0.0);
    for (int i = -1; i <= 1; i++) {
        for (int j = -1; j <= 1; j++) {
            vec2 offv = vec2(float(i), float(j));
            vec2 seed = seedOffset(id + offv);
            float dist = length(gv + seed - offv);
            if (dist < mindist) {
                mindist = dist;
                cell = id + offv + seed;
            }
        }
    }

    vec2 vorv = (cell - iDrift) / CELLS;
    vec3 col = mix(iPrimary, iAccent, clamp(vorv.x * 2.2 + vorv.y, -1.0, 1.0) * 0.5 + 0.5);
    return vec4(blendOverlay(iBase, col), iAlpha);
}
