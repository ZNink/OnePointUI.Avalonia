<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls"
        xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items">
    <Design.PreviewWith>
        <StackPanel Width="500" Height="300" Background="White">
            <controls:SettingCard Header="你好"
                                  Glyph="&#xEB9F;"
                                  Description="介绍"
                                  IsFontIcon="True"
                                  ImageIcon="../../../Assets/OnePointUI.Icon.png"
                                  IsClickable="True">
            </controls:SettingCard>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|SettingCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root">
                    <items:BorderCard
                        ClipToBounds="True"
                        Padding="0"
                        Name="PATH_Border">
                        <Grid>
                            <Border HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Name="PATH_Background"
                                    IsVisible="{TemplateBinding IsClickable}"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="{DynamicResource PrimaryForegroundBrush}"
                                    Opacity="0" />

                            <Border Padding="8">
                                <Grid>
                                    <controls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                       FontSize="24"
                                                       Margin="10,9,0,0"
                                                       IsVisible="{TemplateBinding ShowFontIcon}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top" />

                                    <controls:ToolIcon Kind="{TemplateBinding IconKind}"
                                                       Size="24"
                                                       Margin="10,9,0,0"
                                                       IsVisible="{TemplateBinding ShowGeometryIcon}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top" />
                                    
                                    <Border Width="32" Height="32"
                                            CornerRadius="4"
                                            Margin="5,5,0,0"
                                            IsVisible="{TemplateBinding ShowImageIcon}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            ClipToBounds="True">
                                        <Image Width="32" Height="32"
                                               Stretch="UniformToFill"
                                               Source="{TemplateBinding ImageIcon}"/>
                                    </Border>

                                    <StackPanel VerticalAlignment="Top"
                                                Margin="50,3,0,0">
                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                          FontSize="16">
                                            <ContentPresenter.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="FontSize"
                                                            Value="16" />
                                                </Style>
                                            </ContentPresenter.Styles>
                                        </ContentPresenter>

                                        <ContentPresenter Content="{TemplateBinding Description}">
                                            <ContentPresenter.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="FontSize"
                                                            Value="11" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PrimaryForegroundSecondaryBrush}" />
                                                </Style>
                                            </ContentPresenter.Styles>
                                        </ContentPresenter>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <ContentControl Name="ActionContentControl" 
                                                        Content="{TemplateBinding Content}"
                                                        Margin="0,0,6,0" />

                                        <Border IsVisible="{TemplateBinding IsShowActionIcon}">
                                            <controls:FontIcon Glyph="&#xE974;"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"
                                                               IsVisible="{TemplateBinding IsClickable}"
                                                               FontSize="16" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </items:BorderCard>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="58" />

        <Style Selector="^ /template/ Border#PATH_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.05" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.2" />
        </Style>

        <Style Selector="^ /template/ Button#PATH_Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentControl Content="{TemplateBinding Content}"
                                    Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Style>

    <Style Selector="controls|SettingCard.Navigation">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root">
                    <Grid>
                        <Border HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Name="PATH_Background"
                                IsVisible="{TemplateBinding IsClickable}"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{DynamicResource PrimaryForegroundBrush}"
                                Opacity="0" />

                        <Border Padding="8">
                            <Grid>
                                <controls:FontIcon x:Name="PART_Glyph"
                                                   Glyph="{TemplateBinding Glyph}"
                                                   FontSize="24"
                                                   Margin="10,9,0,0"
                                                   IsVisible="{TemplateBinding ShowFontIcon}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top" />

                                <controls:ToolIcon x:Name="PART_ToolIcon"
                                                   Kind="{TemplateBinding IconKind}"
                                                   Size="24"
                                                   Margin="10,9,0,0"
                                                   IsVisible="{TemplateBinding ShowGeometryIcon}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top" />

                                <Border Width="32" Height="32"
                                        CornerRadius="4"
                                        Margin="5,5,0,0"
                                        IsVisible="{TemplateBinding ShowImageIcon}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        ClipToBounds="True">
                                    <Image Width="32" Height="32"
                                           Stretch="UniformToFill"
                                           Source="{TemplateBinding ImageIcon}"/>
                                </Border>

                                <StackPanel VerticalAlignment="Top"
                                            Margin="50,3,0,0">
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      FontSize="16">
                                        <ContentPresenter.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize"
                                                        Value="16" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>

                                    <ContentPresenter Content="{TemplateBinding Description}">
                                        <ContentPresenter.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize"
                                                        Value="11" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource PrimaryForegroundSecondaryBrush}" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ContentControl Name="ActionContentControl"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="0,0,6,0" />

                                    <Border IsVisible="{TemplateBinding IsShowActionIcon}">
                                        <controls:FontIcon Glyph="&#xE974;"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"
                                                           IsVisible="{TemplateBinding IsClickable}"
                                                           FontSize="16" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="58" />

        <Style Selector="^ /template/ Border#PATH_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.08" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.16" />
        </Style>

        <Style Selector="^.selected /template/ Border#PATH_Background">
            <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}" />
            <Setter Property="Opacity" Value="0.12" />
        </Style>

        <Style Selector="^.selected /template/ controls|FontIcon#PART_Glyph">
            <Setter Property="Foreground" Value="{DynamicResource AccentBackgroundBrush}" />
        </Style>
        <Style Selector="^.selected /template/ controls|ToolIcon#PART_ToolIcon">
            <Setter Property="Stroke" Value="{DynamicResource AccentBackgroundBrush}" />
        </Style>
    </Style>

    <Style Selector="controls|SettingCard.Item">
        <Setter Property="Template">
            <ControlTemplate>
                <Button Name="PATH_Button">
                    <Border
                        ClipToBounds="True"
                        Padding="0"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource PrimaryDisabledForegroundBrush}">
                        <Grid>
                            <Border HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Name="PATH_Background"
                                    IsVisible="{TemplateBinding IsClickable}"
                                    ClipToBounds="True"
                                    Background="{DynamicResource PrimaryForegroundBrush}"
                                    Opacity="0" />

                            <Border Padding="8">
                                <Grid>
                                    <controls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                       FontSize="28"
                                                       Margin="8,0,0,0"
                                                       IsVisible="{TemplateBinding ShowFontIcon}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />

                                    <controls:ToolIcon Kind="{TemplateBinding IconKind}"
                                                       Size="28"
                                                       Margin="8,0,0,0"
                                                       IsVisible="{TemplateBinding ShowGeometryIcon}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />

                                    <Image Width="32" Height="32"
                                           Stretch="UniformToFill"
                                           Margin="6,0,0,0"
                                           IsVisible="{TemplateBinding ShowImageIcon}"
                                           Source="{TemplateBinding ImageIcon}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />

                                    <StackPanel VerticalAlignment="Center"
                                                Margin="50,0,0,0">
                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                          FontSize="18">
                                            <ContentPresenter.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="FontSize"
                                                            Value="18" />
                                                </Style>
                                            </ContentPresenter.Styles>
                                        </ContentPresenter>

                                        <ContentPresenter Content="{TemplateBinding Description}">
                                            <ContentPresenter.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="FontSize"
                                                            Value="12" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PrimaryForegroundSecondaryBrush}" />
                                                </Style>
                                            </ContentPresenter.Styles>
                                        </ContentPresenter>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <ContentControl Name="ActionContentControl"
                                                        Content="{TemplateBinding Content}"
                                                        Margin="0,0,12,0" />

                                        <Border IsVisible="{TemplateBinding IsShowActionIcon}">
                                            <controls:FontIcon Glyph="&#xE974;"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               IsVisible="{TemplateBinding IsClickable}"
                                                               FontSize="16" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Button>
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="72" />

        <Style Selector="^ /template/ Border#PATH_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.1" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.2" />
        </Style>

        <Style Selector="^ /template/ Button#PATH_Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentControl Content="{TemplateBinding Content}"
                                    Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Style>

    <!--
      块状设置卡：Header/Description 组成标题行，Content 以全宽形式置于标题行下方。
      默认模板把 Content 放到卡片右侧并垂直居中，富设置内容（下拉框 + 按钮组、
      进度条、多行表单）会被挤压成狭窄的一列；Block 变体让内容独占整行，
      适合设置页中承载复杂配置的分区卡片。仍保留 ActionContentControl 名称，
      与 SettingCard.OnApplyTemplate 的指针处理兼容。
    -->
    <Style Selector="controls|SettingCard.Block">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root">
                    <items:BorderCard
                        ClipToBounds="True"
                        Padding="0"
                        Name="PATH_Border">
                        <Grid>
                            <Border HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Name="PATH_Background"
                                    IsVisible="{TemplateBinding IsClickable}"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="{DynamicResource PrimaryForegroundBrush}"
                                    Opacity="0" />

                            <StackPanel>
                                <Border Padding="16,12,16,0">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <controls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                           FontSize="20"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{TemplateBinding ShowFontIcon}"
                                                           HorizontalAlignment="Left" />

                                        <controls:ToolIcon Kind="{TemplateBinding IconKind}"
                                                           Size="20"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{TemplateBinding ShowGeometryIcon}"
                                                           HorizontalAlignment="Left" />

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <ContentPresenter Content="{TemplateBinding Header}">
                                                <ContentPresenter.Styles>
                                                    <Style Selector="TextBlock">
                                                        <Setter Property="FontSize"
                                                                Value="16" />
                                                    </Style>
                                                </ContentPresenter.Styles>
                                            </ContentPresenter>

                                            <ContentPresenter Content="{TemplateBinding Description}">
                                                <ContentPresenter.Styles>
                                                    <Style Selector="TextBlock">
                                                        <Setter Property="FontSize"
                                                                Value="11" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource PrimaryForegroundSecondaryBrush}" />
                                                        <Setter Property="TextWrapping"
                                                                Value="Wrap" />
                                                    </Style>
                                                </ContentPresenter.Styles>
                                            </ContentPresenter>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ContentControl Name="ActionContentControl"
                                                Content="{TemplateBinding Content}"
                                                Margin="16,10,16,16"
                                                HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </items:BorderCard>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="0" />

        <Style Selector="^ /template/ Border#PATH_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.05" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PATH_Background">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
    </Style>
</Styles>