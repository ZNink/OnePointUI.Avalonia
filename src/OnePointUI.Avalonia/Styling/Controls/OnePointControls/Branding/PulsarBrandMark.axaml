<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Branding">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <branding:PulsarBrandMark Width="48" Height="48" />
                <branding:PulsarBrandMark Width="24" Height="24" />
                <branding:PulsarBrandMark Width="16" Height="16" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- 品牌标记默认用主题前景色：跟着深浅色主题与强调色走，不写死颜色。 -->
    <Style Selector="branding|PulsarBrandMark">
        <Setter Property="MarkBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
        <!-- 兜底尺寸：控件没有模板，不显式给尺寸时 DesiredSize 为 0，会静默消失。 -->
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
