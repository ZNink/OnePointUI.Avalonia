<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="16">
                <!-- 正常样式（默认）：完整展示每一项 -->
                <controls:SegmentedButton SelectedIndex="0">
                    <controls:SegmentedButtonItem Content="Classic" />
                    <controls:SegmentedButtonItem Content="Bedrock" />
                    <controls:SegmentedButtonItem Content="Developer" />
                </controls:SegmentedButton>

                <!-- 动态样式：仅选中项完整展开，其余项仅图标 / 首字符，悬停不展开 -->
                <controls:SegmentedButton SelectedIndex="0" DisplayMode="Dynamic">
                    <controls:SegmentedButtonItem Content="Classic" Glyph="&#xE8FC;" />
                    <controls:SegmentedButtonItem Content="Bedrock" Glyph="&#xE790;" />
                    <controls:SegmentedButtonItem Content="Developer" />
                    <controls:SegmentedButtonItem Content="Experimental" Glyph="&#xE9D2;" />
                </controls:SegmentedButton>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|SegmentedButton">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid>
                        <Border Name="PART_Backdrop"
                                Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0.45"
                                IsHitTestVisible="False">
                            <Border Name="PART_AccentTint"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0.30" />
                        </Border>

                        <Border Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <ScrollViewer Name="PART_ScrollViewer"
                                          ClipToBounds="True"
                                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                          IsScrollInertiaEnabled="{TemplateBinding (ScrollViewer.IsScrollInertiaEnabled)}"
                                          BringIntoViewOnFocusChange="True">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|SegmentedButtonItem">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!--
            动态样式下条目宽度由代码托管（实测自然宽度 ↔ CollapsedItemWidth），
            两端都是具体数值，CubicEaseOut 保证非线性衔接。
        -->
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width"
                                  Duration="0:0:0.24"
                                  Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_SelectedSurface"
                            Background="{DynamicResource AccentSubtleBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.18"
                                                  Easing="QuinticEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_HoverSurface"
                            Background="{DynamicResource PrimaryBackgroundOverBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.18"
                                                  Easing="QuinticEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_SelectedHoverSurface"
                            Background="{DynamicResource AccentSubtleHoverBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.18"
                                                  Easing="QuinticEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_PressedSurface"
                            Background="{DynamicResource PrimaryBackgroundPressedBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.08" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_SelectedPressedSurface"
                            Background="{DynamicResource AccentSubtlePressedBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.08" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <controls:PointHalo Name="PART_PointHalo"
                                        CornerRadius="{TemplateBinding CornerRadius}" />

                    <Border Name="PART_Focus"
                            Margin="1"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource AccentBackgroundBrush}"
                            BorderThickness="1"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <!--
                        展开态内容行：图标（有 Glyph 时）+ 文本，整体居中。
                        与改造前的单 ContentPresenter 结构等价：无 Glyph 时
                        图标列宽度为 0，文本居中显示，外观与旧版完全一致。
                    -->
                    <Grid Name="PART_FullRow"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="{TemplateBinding Padding}">
                        <Grid.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.14"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Grid.Transitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:FontIcon Name="PART_Icon"
                                           Grid.Column="0"
                                           Glyph="{TemplateBinding Glyph}"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>

                    <!--
                        收缩态内容：仅图标（有 Glyph 时）或名称首字符头像，
                        在条目内居中。与 PART_FullRow 同格重叠、交叉淡隐，
                        不在布局上来回切换，避免宽度动画期间的内容跳动。
                    -->
                    <Panel Name="PART_CompactRow"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0"
                           IsHitTestVisible="False">
                        <Panel.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.14"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Panel.Transitions>
                        <controls:FontIcon Name="PART_CompactIcon"
                                           Glyph="{TemplateBinding Glyph}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                        <Border Name="PART_Avatar"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource AccentSubtleBrush}"
                                IsVisible="False">
                            <TextBlock Name="PART_AvatarText"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBackgroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <Border Name="PART_SelectionIndicator"
                            Width="0"
                            Height="3"
                            Margin="0,0,0,3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBackgroundBrush}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width"
                                                  Duration="0:0:0.2"
                                                  Easing="ExponentialEaseOut" />
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.14" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_HoverSurface">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_HoverSurface">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_PressedSurface">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBackgroundBrush}" />

            <Style Selector="^ /template/ Border#PART_SelectedSurface">
                <Setter Property="Opacity" Value="1" />
            </Style>

            <Style Selector="^:pointerover /template/ Border#PART_HoverSurface">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <Style Selector="^:pointerover /template/ Border#PART_SelectedHoverSurface">
                <Setter Property="Opacity" Value="1" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_SelectedHoverSurface">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_PressedSurface">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_SelectedPressedSurface">
                <Setter Property="Opacity" Value="1" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectionIndicator">
                <Setter Property="Width" Value="20" />
                <Setter Property="Opacity" Value="1" />
            </Style>

            <Style Selector="^:pointerover /template/ Border#PART_SelectionIndicator">
                <Setter Property="Width" Value="28" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_SelectionIndicator">
                <Setter Property="Width" Value="14" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!--
            动态样式收缩态（宿主广播后由代码挂上的 collapsed 类）：
            文本行淡出、图标 / 首字符行淡入；解除最小宽度与内边距约束，
            让条目收缩到 CollapsedItemWidth（默认 44）。
        -->
        <Style Selector="^.collapsed">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="^.collapsed /template/ Grid#PART_FullRow">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^.collapsed /template/ Panel#PART_CompactRow">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Style>
</Styles>
