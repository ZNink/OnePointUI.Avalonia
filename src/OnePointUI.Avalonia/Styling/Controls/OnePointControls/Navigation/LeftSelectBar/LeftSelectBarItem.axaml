<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.LeftSelectBar"
        xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls">
    <Design.PreviewWith>
        <controls:LeftSelectBar>
            <controls:LeftSelectBarItem ItemText="111111111111" />
            <controls:LeftSelectBarItem ItemText="111" />
            <controls:LeftSelectBarItem ItemText="111" />
        </controls:LeftSelectBar>
    </Design.PreviewWith>

    <Style Selector="controls|LeftSelectBarItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border CornerRadius="{TemplateBinding CornerRadius}"
                            Name="PART_Background"
                            Background="{DynamicResource PrimaryBackgroundOverBrush}"
                            Opacity="0.000001">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.38"
                                                  Easing="QuarticEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Panel>
                            <Border Width="0"
                                    Name="PART_AccentBackground"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left"
                                    Opacity="0"
                                    Background="{DynamicResource AccentBackgroundBrush}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Width"
                                                          Duration="0:0:0.42"
                                                          Easing="ExponentialEaseOut" />

                                        <DoubleTransition Property="Height"
                                                          Duration="0:0:0.42"
                                                          Easing="ExponentialEaseOut" />

                                        <DoubleTransition Property="Opacity"
                                                          Duration="0:0:0.2"
                                                          Easing="QuarticEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Panel>
                    </Border>

                    <Border CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="0,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="8">
                            <onePointControls:FontIcon Glyph="{TemplateBinding Glyph}"
                                                       Name="PART_Icon"
                                                       FontSize="18"
                                                       IsVisible="{Binding IconKind, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                <onePointControls:FontIcon.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="FontSize"
                                                          Duration="0:0:0.28" />
                                        <ThicknessTransition Property="Margin"
                                                             Duration="0:0:0.28" />
                                    </Transitions>
                                </onePointControls:FontIcon.Transitions>
                            </onePointControls:FontIcon>

                            <onePointControls:ToolIcon Name="PART_ToolIcon"
                                                       Kind="{TemplateBinding IconKind}"
                                                       Size="18"
                                                       IsVisible="{Binding IconKind, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{TemplateBinding ItemText}"
                                       Name="PART_Text"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

    <Style Selector="^:selected">
        <Style Selector="^ /template/ Border#PART_AccentBackground">
            <Setter Property="Width"
                    Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- 选中态底色为强调色，文字与图标切换到高对比前景，保证深浅色下的可读性。 -->
        <Style Selector="^ /template/ TextBlock#PART_Text">
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="^ /template/ onePointControls|FontIcon#PART_Icon">
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="^ /template/ onePointControls|ToolIcon#PART_ToolIcon">
            <Setter Property="Stroke"
                    Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
    </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Style>
</Styles>