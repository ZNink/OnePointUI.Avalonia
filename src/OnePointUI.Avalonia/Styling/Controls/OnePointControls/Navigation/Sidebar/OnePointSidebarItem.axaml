<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls"
        xmlns:sidebar="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.Sidebar">
    <Design.PreviewWith>
        <Border Padding="20" Width="248" Background="{DynamicResource SidebarBackgroundBrush}">
            <StackPanel Spacing="2">
                <sidebar:OnePointSidebarItem Glyph="&#xE80F;" ItemText="主页" NavigationKey="Home" IsSelected="True" />
                <sidebar:OnePointSidebarItem Glyph="&#xE74C;" ItemText="扩展" NavigationKey="Extensions" BadgeText="3" />
                <sidebar:OnePointSidebarItem Glyph="&#xE90F;" ItemText="工具" NavigationKey="Tools" />
                <sidebar:OnePointSidebarItem Glyph="&#xE719;" ItemText="市场" NavigationKey="Market" />
                <sidebar:OnePointSidebarItem Glyph="&#xE713;" ItemText="设置" NavigationKey="Settings" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!--
        侧边栏按钮 = 底部停靠项竖过来：
        · 几何与底栏一致：44px 高、8px 圆角、图标 16 + 文字、左右留白
        · 悬停 = 弱底（与底栏同一个 PrimaryBackgroundOverBrush）
        · 选中 = 强调色文字 + 强调色底 + 贴在右侧的 4px 强调条
          （底栏的选中条在底边、22×4、两端 5px 圆角；竖过来就是右边、4×22，圆角跟着转）
        · 按下 = 整项轻微降透明度；键盘焦点 = 2px 强调色内描边
        · 单一形态：文本始终显示，没有紧凑/折叠态
    -->
    <Style Selector="sidebar|OnePointSidebarItem">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSecondaryBrush}" />
        <!--
            不要给 Foreground 加 BrushTransition：它是继承属性，过渡期间每一帧都会重新下发到
            子元素并触发一次布局，页面较重时会掉帧。颜色切换直接生效，动效交给背景透明度。
        -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_Root"
                       Background="Transparent"
                       ClipToBounds="False">
                    <Panel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="QuinticEaseOut" />
                        </Transitions>
                    </Panel.Transitions>

                    <Border Name="PART_Hover"
                            Margin="2,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{DynamicResource PrimaryBackgroundOverBrush}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="ExponentialEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_Selected"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{DynamicResource SidebarItemSelectedBrush}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="ExponentialEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <!--
                        选中标记：底栏那条 22×4、两端 5px 圆角的强调条竖过来——
                        变成贴在右侧的 4×22，圆角跟着转成 0,5,5,0，向右探出 3px。
                        生长走 RenderTransform：几何恒定，动画期间不会逐帧重排整棵可视树。
                    -->
                    <Border Name="PART_Indicator"
                            Width="4"
                            Height="22"
                            Margin="0,0,-3,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="0,5,5,0"
                            Background="{DynamicResource AccentBackgroundBrush}"
                            Opacity="0"
                            RenderTransform="scale(1,0)"
                            RenderTransformOrigin="0.5,0.5"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform"
                                                               Duration="0:0:0.42"
                                                               Easing="ExponentialEaseOut" />
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.38"
                                                  Easing="ExponentialEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_Focus"
                            Margin="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource AccentBackgroundBrush}"
                            BorderThickness="2"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <Grid Name="PART_Content"
                          Margin="12,0"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">
                        <Panel Name="PART_IconHost"
                               Grid.Column="0"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                            <Panel.Transitions>
                                <Transitions>
                                    <!-- 悬停位移走变换，避免逐帧触发布局 -->
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.1"
                                                                   Easing="QuinticEaseOut" />
                                </Transitions>
                            </Panel.Transitions>
                            <onePointControls:FontIcon Name="PART_Icon"
                                                       Glyph="{TemplateBinding Glyph}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="16"
                                                       IsVisible="{TemplateBinding HasGlyphIcon}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            <!-- 可选：Avalonia PathIcon 等矢量图标，替代字形图标，始终几何居中 -->
                            <ContentPresenter Name="PART_CustomIcon"
                                              Content="{TemplateBinding Icon}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              IsVisible="{TemplateBinding HasCustomIcon}"
                                              IsHitTestVisible="False" />
                            <Ellipse Name="PART_StatusDot"
                                     Width="9"
                                     Height="9"
                                     Margin="0,0,-2,-2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     IsVisible="{TemplateBinding ShowStatusDot}"
                                     Fill="{DynamicResource SidebarStatusDotBrush}"
                                     Stroke="{DynamicResource SidebarBackgroundBrush}"
                                     StrokeThickness="2" />
                        </Panel>

                        <TextBlock Name="PART_Text"
                                   Grid.Column="1"
                                   Text="{TemplateBinding ItemText}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />

                        <Panel Name="PART_BadgeHost"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right">
                            <Border Name="PART_Badge"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="5,0"
                                    CornerRadius="9"
                                    Background="{DynamicResource AccentBackgroundBrush}"
                                    IsVisible="{TemplateBinding HasBadge}">
                                <TextBlock Text="{TemplateBinding BadgeText}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Name="PART_BadgeDot"
                                     Width="8"
                                     Height="8"
                                     IsVisible="{TemplateBinding ShowBadgeDot}"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Panel>
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style Selector="^:pointerover /template/ Panel#PART_IconHost">
            <Setter Property="RenderTransform" Value="translate(2px,0)" />
        </Style>

        <Style Selector="^:pressed /template/ Panel#PART_Root">
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBackgroundBrush}" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_Selected">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_Indicator">
            <Setter Property="RenderTransform" Value="scale(1,1)" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:selected:pointerover /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- 状态点：语义色调全部走平台状态令牌 -->
        <Style Selector="^:tone-none /template/ Ellipse#PART_StatusDot">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:tone-success /template/ Ellipse#PART_StatusDot">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>

        <Style Selector="^:tone-warning /template/ Ellipse#PART_StatusDot">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>

        <Style Selector="^:tone-error /template/ Ellipse#PART_StatusDot">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <!-- 禁用态：降低对比度且不参与指针反馈 -->
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDisabledForegroundBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Indicator">
            <Setter Property="RenderTransform" Value="scale(1,0)" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Selected">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </Style>
</Styles>
