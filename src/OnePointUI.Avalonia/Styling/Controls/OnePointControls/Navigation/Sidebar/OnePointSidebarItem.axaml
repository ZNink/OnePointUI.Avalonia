<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls"
        xmlns:sidebar="using:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.Sidebar">
    <Design.PreviewWith>
        <Border Padding="20" Width="72" Background="{DynamicResource SidebarBackgroundBrush}">
            <StackPanel Spacing="6">
                <sidebar:OnePointSidebarItem Glyph="&#xE80F;" ItemText="主页" NavigationKey="Home" IsSelected="True" />
                <sidebar:OnePointSidebarItem Glyph="&#xE74C;" ItemText="扩展" NavigationKey="Extensions" BadgeText="3" />
                <sidebar:OnePointSidebarItem Glyph="&#xE90F;" ItemText="工具" NavigationKey="Tools" />
                <sidebar:OnePointSidebarItem Glyph="&#xE719;" ItemText="市场" NavigationKey="Market" />
                <sidebar:OnePointSidebarItem Glyph="&#xE713;" ItemText="设置" NavigationKey="Settings" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!--
        侧边栏按钮 = 底部停靠栏按钮（同一份几何与状态语言）：
        · 72×44，图标 16 在上、文字 10 在下，全部居中；图标与文字在任何状态下都不位移
        · 悬停 = 弱底（与底栏同一个 PrimaryBackgroundOverBrush），没有位移/缩放
        · 选中 = 强调色文字 + 图标着色 + 项目下方那条 22×4、两端 5px 圆角的强调条
        · 键盘焦点 = 2px 强调色内描边
        · 单一形态：只有这一种（图标栏），没有展开态
    -->
    <Style Selector="sidebar|OnePointSidebarItem">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSecondaryBrush}" />
        <!--
            不要给 Foreground 加 BrushTransition：它是继承属性，过渡期间每一帧都会重新下发到
            子元素并触发一次布局，页面较重时会掉帧。颜色切换直接生效，动效交给背景透明度。
        -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_Root"
                       Background="Transparent"
                       ClipToBounds="False">
                    <Border Name="PART_Hover"
                            Margin="2,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{DynamicResource PrimaryBackgroundOverBrush}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="ExponentialEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <!--
                        内容是一个固定的竖排：图标在上、文字在下。任何状态都不改 Margin、
                        不改 RenderTransform，所以图标与文字永远不会动。
                    -->
                    <StackPanel Name="PART_Content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="1">
                        <Panel Name="PART_IconHost"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center">
                            <onePointControls:FontIcon Name="PART_Icon"
                                                       Glyph="{TemplateBinding Glyph}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="16"
                                                       IsVisible="{TemplateBinding HasGlyphIcon}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            <!-- 可选：Avalonia PathIcon 等矢量图标，替代字形图标，始终几何居中 -->
                            <ContentPresenter Name="PART_CustomIcon"
                                              Content="{TemplateBinding Icon}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              IsVisible="{TemplateBinding HasCustomIcon}"
                                              IsHitTestVisible="False" />
                            <Ellipse Name="PART_StatusDot"
                                     Width="9"
                                     Height="9"
                                     Margin="0,0,-2,-2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     IsVisible="{TemplateBinding ShowStatusDot}"
                                     Fill="{DynamicResource SidebarStatusDotBrush}"
                                     Stroke="{DynamicResource SidebarBackgroundBrush}"
                                     StrokeThickness="2" />
                            <!-- 数字徽标：图标右上角的小药丸，不参与排版 -->
                            <Border Name="PART_Badge"
                                    MinWidth="14"
                                    Height="14"
                                    Padding="4,0"
                                    Margin="0,-4,-6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="7"
                                    Background="{DynamicResource AccentBackgroundBrush}"
                                    IsVisible="{TemplateBinding HasBadge}">
                                <TextBlock Text="{TemplateBinding BadgeText}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Name="PART_BadgeDot"
                                     Width="8"
                                     Height="8"
                                     Margin="0,-2,-2,0"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     IsVisible="{TemplateBinding ShowBadgeDot}"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Panel>

                        <TextBlock Name="PART_Text"
                                   Text="{TemplateBinding ItemText}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   MaxWidth="64"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Name="PART_Focus"
                            Margin="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource AccentBackgroundBrush}"
                            BorderThickness="2"
                            Opacity="0"
                            IsHitTestVisible="False" />

                    <!--
                        选中标记：与底栏完全一致——22×4、两端 5px 圆角、贴在项目下缘并向下探出 3px。
                        生长只用 RenderTransform，几何恒定，动画期间不触发重排。
                    -->
                    <Border Name="PART_Indicator"
                            Width="22"
                            Height="4"
                            Margin="0,0,0,-3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            CornerRadius="5,5,0,0"
                            Background="{DynamicResource AccentBackgroundBrush}"
                            Opacity="0"
                            RenderTransform="scale(0,1)"
                            RenderTransformOrigin="0.5,0.5"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform"
                                                               Duration="0:0:0.42"
                                                               Easing="ExponentialEaseOut" />
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.38"
                                                  Easing="ExponentialEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBackgroundBrush}" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_Indicator">
            <Setter Property="RenderTransform" Value="scale(1,1)" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:selected:pointerover /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- 状态点：语义色调全部走平台状态令牌 -->
        <Style Selector="^:tone-none /template/ Ellipse#PART_StatusDot">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:tone-success /template/ Ellipse#PART_StatusDot">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>

        <Style Selector="^:tone-warning /template/ Ellipse#PART_StatusDot">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>

        <Style Selector="^:tone-error /template/ Ellipse#PART_StatusDot">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <!-- 禁用态：降低对比度且不参与指针反馈 -->
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDisabledForegroundBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Hover">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Indicator">
            <Setter Property="RenderTransform" Value="scale(0,1)" />
            <Setter Property="Opacity" Value="0" />
        </Style>
    </Style>
</Styles>
