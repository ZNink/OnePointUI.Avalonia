<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Width="240" Spacing="10">
                <Menu>
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" InputGesture="Ctrl+N" />
                        <MenuItem Header="_Open" InputGesture="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="E_xit" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Cut" InputGesture="Ctrl+X" />
                        <MenuItem Header="_Copy" InputGesture="Ctrl+C" />
                    </MenuItem>
                    <MenuItem Header="_Help" IsEnabled="False" />
                </Menu>

                <TextBlock Text="右键窗口任意位置查看 ContextMenu" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Menu 容器 -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- 顶层 MenuItem -->
    <Style Selector="Menu > MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Header"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_HeaderPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>

        <Style Selector="^:open Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource AccentSubtlePressedBrush}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Style>

    <!-- 子级 MenuItem（在 Popup 中显示） -->
    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- 图标列固定占位：没有图标的选项也保留 16+8 缩进，
                                 与带图标的选项文字对齐；整菜单都无图标时由
                                 MenuEffects 挂 no-icons 类整体收起。 -->
                            <ContentPresenter Grid.Column="0"
                                              Name="PART_IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              Name="PART_HeaderPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGesture}"
                                       Margin="16,0,0,0"
                                       Foreground="{DynamicResource PrimaryDisabledForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <!-- 子菜单弹出层：与 ContextMenu 一致的毛玻璃与圆角。
                             打开/关闭动画目前只做在 ContextMenu 上，子菜单保持直落。 -->
                        <Popup Name="PART_Popup"
                               Placement="Right"
                               IsLightDismissEnabled="False"
                               WindowManagerAddShadowHint="False">
                            <Border Name="PART_SubMenuBorder"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Panel>
                                    <!-- 玻璃底层：MenuEffects 复用主菜单打开时
                                         截好的宿主快照，按本子菜单位置裁剪铺在这里。 -->
                                    <Border Name="PART_SubMenuBackdropBlur"
                                            IsVisible="False"
                                            IsHitTestVisible="False" />
                                    <!-- 与 ContextMenu 同款色调层（普通半透明 Border）：
                                         玻璃层就绪时挂 glass 类切换到
                                         MenuGlassBackdropBrush；不要用 DWM acrylic，
                                         弹层上它只得到不透明灰板。 -->
                                    <Border Name="PART_SubMenuTint"
                                            Background="{DynamicResource MenuBackdropBrush}"
                                            IsHitTestVisible="False">
                                        <Panel>
                                            <Border Name="PART_SubMenuSheen"
                                                    Background="{DynamicResource MenuGlassSheenBrush}"
                                                    IsVisible="False"
                                                    IsHitTestVisible="False" />
                                            <Border Name="PART_SubMenuRim"
                                                    BorderBrush="{DynamicResource MenuGlassRimBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    IsVisible="False"
                                                    IsHitTestVisible="False" />
                                        </Panel>
                                    </Border>
                                    <ScrollViewer MaxHeight="480"
                                                  Margin="4"
                                                  Padding="0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Style>    <!-- 子菜单玻璃层就绪：与主菜单同款高透明度色调（约 40%）。 -->
    <Style Selector="Border#PART_SubMenuTint.glass">
        <Setter Property="Background" Value="{DynamicResource MenuGlassBackdropBrush}" />
    </Style>
    <Style Selector="Border#PART_SubMenuTint.glass Border#PART_SubMenuSheen">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border#PART_SubMenuTint.glass Border#PART_SubMenuRim">
        <Setter Property="IsVisible" Value="True" />
    </Style>

</Styles>
